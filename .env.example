# Render / production backend environment variables
# Copy this file to `.env` and fill in real values. NEVER commit real secrets.

# PostgreSQL (Supabase pooled connection)
# Equivalent to:
# DB_URL=jdbc:postgresql://<host>:<port>/postgres?prepareThreshold=0
DB_HOST=your-db-host
DB_PORT=6543
DB_NAME=postgres
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password

# Redis (matches Spring Redisson defaults)
REDIS_URL=redis://default:your-redis-password@your-redis-host:port
REDIS_PASSWORD=your-redis-password

# JWT
JWT_SECRET=your-256-bit-jwt-secret
JWT_EXPIRATION=86400000

# Execution
EXECUTION_MODE=remote
EXECUTION_WORKER_COUNT=1
EXECUTOR_AGENT_BASE_URL=http://your-executor-host
EXECUTOR_AGENT_TOKEN=your-executor-agent-token
EXECUTOR_AGENT_TIMEOUT_MS=90000

# CORS
APP_CORS_ALLOWED_ORIGINS=https://localhost:3000

# Logging
LOG_LEVEL=INFO
